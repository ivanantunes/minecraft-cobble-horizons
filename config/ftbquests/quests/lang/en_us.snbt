{
 "chapter.C0BB1E0000000001.title": "CobbleHorizons Adventure"
 "chapter.C0BB1E0000000001.chapter_subtitle": ["A guided journey from your first Poké Ball to the Champion horizon."]
 "quest.C0BB1E0000000101.title": "Field Essentials"
 "quest.C0BB1E0000000101.quest_desc": ["Choose your starter, gather Apricorns, and obtain your first Poké Ball."]
 "quest.C0BB1E0000000102.title": "Your First Catch"
 "quest.C0BB1E0000000102.quest_desc": ["Study a wild Pokémon, weaken it when necessary, and make your first successful capture."]
 "quest.C0BB1E0000000103.title": "Begin Field Research"
 "quest.C0BB1E0000000103.quest_desc": ["Craft or obtain a Pokédex and begin documenting the Pokémon found throughout the world."]
 "quest.C0BB1E0000000104.title": "Test Your Strategy"
 "quest.C0BB1E0000000104.quest_desc": ["Find a trainer in the world and win your first official trainer battle."]
 "quest.C0BB1E0000000105.title": "Build a Balanced Team"
 "quest.C0BB1E0000000105.quest_desc": ["Assemble a full party of six Pokémon with varied types and roles."]
 "quest.C0BB1E0000000106.title": "A Stronger Form"
 "quest.C0BB1E0000000106.quest_desc": ["Train one of your partners until it evolves."]
 "quest.C0BB1E0000000107.title": "Recovery Routine"
 "quest.C0BB1E0000000107.quest_desc": ["Use a fully charged Healing Machine before continuing your expedition."]
 "quest.C0BB1E0000000108.title": "Your First Gym Badge"
 "quest.C0BB1E0000000108.quest_desc": ["Find a gym, prepare suitable counters, and defeat any gym leader."]
 "quest.C0BB1E0000000109.title": "Rising Challenger"
 "quest.C0BB1E0000000109.quest_desc": ["Defeat three different gym leaders. Rotate your team instead of relying on one partner."]
 "quest.C0BB1E0000000110.title": "Gym Veteran"
 "quest.C0BB1E0000000110.quest_desc": ["Defeat eight different gym leaders and prove your team can answer many battle styles."]
 "quest.C0BB1E0000000111.title": "Mega Breakthrough"
 "quest.C0BB1E0000000111.quest_desc": ["Equip the correct accessories and Mega Evolve a compatible Pokémon."]
 "quest.C0BB1E0000000112.title": "A Legendary Call"
 "quest.C0BB1E0000000112.quest_desc": ["Craft the Arc Phone and begin investigating legendary monuments and relics."]
 "quest.C0BB1E0000000113.title": "Legendary Encounter"
 "quest.C0BB1E0000000113.quest_desc": ["Complete any supported monument ritual and encounter a legendary Pokémon."]
 "quest.C0BB1E0000000114.title": "The Elite Gauntlet"
 "quest.C0BB1E0000000114.quest_desc": ["Defeat every Elite Four-class trainer tracked by Radical Cobblemon Trainers."]
 "quest.C0BB1E0000000115.title": "Champion of the Horizon"
 "quest.C0BB1E0000000115.quest_desc": ["Defeat every Champion-class trainer and complete the main CobbleHorizons adventure."]
}
