{
  "rules": [
    {
      "name": "Preserve vanilla support and progression entities",
      "what": "ALLOW_SPAWN",
      "when": {
        "entityId": [
          "minecraft:villager",
          "minecraft:wandering_trader",
          "minecraft:iron_golem",
          "minecraft:snow_golem",
          "minecraft:ender_dragon",
          "minecraft:wither",
          "minecraft:cow",
          "minecraft:pig",
          "minecraft:chicken",
          "minecraft:sheep"
        ]
      }
    },
    {
      "name": "Disable world-generated vanilla mobs",
      "what": "DISALLOW_SPAWN",
      "when": {
        "entityId": [
          "minecraft:*"
        ],
        "spawnType": [
          "NATURAL",
          "CHUNK_GENERATION",
          "SPAWNER",
          "PATROL",
          "REINFORCEMENT",
          "JOCKEY",
          "TRIAL_SPAWNER"
        ]
      }
    }
  ],
  "logLevel": "INFO"
}
